PORT=8000
# Same database as the Express backend
MONGO_URI=mongodb://127.0.0.1:27017/student_expense_tracker

# IMPORTANT: must be exactly the same value as JWT_SECRET in backend/.env,
# because this service verifies the tokens that the Express backend creates.
JWT_SECRET=change_this_to_a_long_random_secret

# Frontend addresses allowed to call this API (comma separated)
CORS_ORIGINS=http://localhost:5173
