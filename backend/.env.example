PORT=5000
# Local MongoDB (MongoDB Community Server installed on your laptop)
MONGO_URI=mongodb://127.0.0.1:27017/student_expense_tracker
# Or MongoDB Atlas (cloud), replace with your own connection string:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/student_expense_tracker

# Secret used to sign login tokens. Change it to any long random text.
JWT_SECRET=change_this_to_a_long_random_secret
